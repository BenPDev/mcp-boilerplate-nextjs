{
  "name": "mcp-nextjs-production-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "10.29.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@hono/node-server": "1.19.10",
      "fast-uri": "3.1.5",
      "hono": "4.12.25",
      "path-to-regexp": "8.4.0"
    }
  },
  "scripts": {
    "dev": "pnpm build:widget && concurrently --kill-others-on-fail \"pnpm dev:widget\" \"next dev\"",
    "dev:widget": "vite build --config web/vite.config.ts --watch",
    "build:widget": "vite build --config web/vite.config.ts",
    "validate:config": "tsx scripts/validate-production-config.ts",
    "build": "pnpm validate:config && pnpm build:widget && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:widget && tsx --test tests/**/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector@latest"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "mcp-handler": "2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
